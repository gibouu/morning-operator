    "Seen on %lld distinct days. Open a quote to inspect the original sampled screen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@n@"
          },
          "substitutions": {
            "n": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "Seen on %arg day. Open a quote to inspect the original sampled screen."
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "Seen on %arg distinct days. Open a quote to inspect the original sampled screen."
                    }
                  }
                }
              }
            }
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@n@"
          },
