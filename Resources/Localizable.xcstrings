    "The Apple app save could not be confirmed. Check it before retrying. %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement dans l’app Apple n’a pas pu être confirmé. Vérifiez-le avant de réessayer. %@"
          }
        }
      }
    },
    "The alarm couldn't be saved. Check it and try again. %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le réveil n’a pas pu être enregistré. Vérifiez-le et réessayez. %@"
          }
        }
      }
    },
    "The alarm opens your approved morning after you stop it. Unlock your phone if asked.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêter le réveil ouvre votre matinée approuvée. Déverrouillez l’iPhone si nécessaire."
          }
        }
      }
    },
    "The category organizes your routine. Choose an action below to decide what Morning Operator does.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La catégorie organise votre routine. Choisissez une action ci-dessous pour décider de ce que fait Morning Operator."
          }
        }
      }
    },
    "The change could not be saved. Try again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La modification n’a pas pu être enregistrée. Réessayez."
          }
        }
      }
    },
    "The date is spoken too. This is a saved excerpt, not today's messages. MORE checks its source before every playback.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La date est lue aussi. Il s’agit d’un extrait enregistré, pas des messages du jour. MORE vérifie sa source avant chaque lecture."
          }
        }
      }
    },
    "The draft couldn't be saved. Your current routine is unchanged.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le brouillon n’a pas pu être enregistré. Votre routine actuelle n’a pas changé."
          }
        }
      }
    },
    "The extracted text could not be saved. Your recording is kept for retry.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte extrait n’a pas pu être enregistré. Votre enregistrement est conservé pour réessayer."
          }
        }
      }
    },
    "The file couldn't be prepared. %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier n’a pas pu être préparé. %@"
