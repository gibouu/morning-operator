              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "Vous avez relu %arg échantillon. Vos libellés et vos choix « inconnu » priment ; le texte d’origine et les résultats du modèle restent disponibles."
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
