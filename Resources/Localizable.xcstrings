{
  "sourceLanguage": "en",
  "strings": {
    "%02d:%02d in this recording": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$02d:%2$02d in this recording"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$02d:%2$02d dans cet enregistrement"
          }
        }
      }
    },
    "%@ Your existing file is protected from changes.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Votre fichier existant est protégé contre toute modification."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Your existing file is protected from changes."
          }
        }
      }
    },
    "%@ Your existing file is protected; new changes cannot be saved until it can be restored.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Votre fichier existant est protégé ; les nouvelles modifications ne pourront pas être enregistrées tant qu’il n’aura pas été restauré."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Your existing file is protected; new changes cannot be saved until it can be restored."
          }
        }
      }
    },
    "%@ Your saved observations remain available.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Vos observations enregistrées restent disponibles."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Your saved observations remain available."
          }
        }
      }
    },
    "%@ closes right after opening. In Shortcuts, check that its closing automation has only Is Closed selected; until then recordings can't use its times.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se ferme juste après s’être ouvert. Dans Raccourcis, vérifiez que son automatisation de fermeture n’a que « Est fermée » coché ; d’ici là, les enregistrements ne peuvent pas utiliser ses heures."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ closes right after opening. In Shortcuts, check that its closing automation has only Is Closed selected; until then recordings can't use its times."
          }
        }
      }
    },
