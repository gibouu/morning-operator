      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez l’invitation pour ouvrir MORE et commencer votre matinée approuvée. Cette invitation unique garde le même instant si vous changez de fuseau horaire."
          }
        }
      }
    },
