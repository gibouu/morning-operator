    },
    "This shows a morning you've chosen to start. It doesn't start recording or listen in the background.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela affiche une matinée que vous avez choisi de commencer. Cela ne lance pas d’enregistrement et n’écoute pas en arrière-plan."
          }
        }
      }
    },
    "This step has reached its extension limit.": {
      "localizations": {
        "fr": {
          "stringUnit": {
