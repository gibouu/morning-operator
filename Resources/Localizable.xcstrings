        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measured or estimated?"
          }
        }
      }
    },
    "Measured: Screen Time counted these minutes inside your morning. Estimated: an hour ran past the end of your morning, so its minutes were shared out.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesuré : Temps d’écran a compté ces minutes pendant votre matin. Estimé : une heure dépassait la fin de votre matin, ses minutes ont donc été réparties."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measured: Screen Time counted these minutes inside your morning. Estimated: an hour ran past the end of your morning, so its minutes were shared out."
          }
        }
      }
    },
