      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les libellés viennent de la reconnaissance ou de votre relecture. Les échantillons peuvent manquer de l’activité et ne mesurent ni le temps passé, ni les touchers, lectures ou défilements."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Labels come from recognition or your review. Samples can miss activity and don't measure time spent, taps, reads or scrolls."
          }
        }
