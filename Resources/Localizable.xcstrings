              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "You reviewed %arg sample. Your labels and unknown choices take priority; original text and model results stay available."
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "You reviewed %arg samples. Your labels and unknown choices take priority; original text and model results stay available."
                    }
