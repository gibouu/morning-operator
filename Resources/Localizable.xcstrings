    "Measured minutes come from complete hourly segments inside the detected morning. Other minutes are estimated from a partial hour.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les minutes mesurées viennent d’heures entières dans la matinée détectée. Les autres sont estimées à partir d’une heure partielle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measured minutes come from complete hourly segments inside the detected morning. Other minutes are estimated from a partial hour."
          }
        }
