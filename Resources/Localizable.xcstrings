    "Across %lld timed runs": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Across %#@n@"
          },
          "substitutions": {
            "n": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
