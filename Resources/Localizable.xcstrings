            "value": "Messages and email aren't connected here yet. Automatic room detection and continuous voice commands also need further work."
          }
        }
      }
    },
    "Minutes are planned, not measured averages. Visible words don't prove an action or a repeated habit.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les minutes sont prévues, pas des moyennes mesurées. Des mots visibles ne prouvent ni une action ni une habitude répétée."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minutes are planned, not measured averages. Visible words don't prove an action or a repeated habit."
          }
        }
      }
    },
    "Minutes are planned. Editing creates a new draft; your saved mornings keep their original routine.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les minutes sont prévues. Modifier crée un nouveau brouillon ; vos matinées enregistrées gardent leur routine d’origine."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minutes are planned. Editing creates a new draft; your saved mornings keep their original routine."
          }
