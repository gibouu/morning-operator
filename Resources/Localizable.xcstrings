          "stringUnit": {
            "state": "translated",
            "value": "Apple exige un accès complet au calendrier pour lire les événements. MORE ne lit que les calendriers que vous sélectionnez ; ce récap ne les modifie pas."
          }
        },
        "en": {
          "stringUnit": {
