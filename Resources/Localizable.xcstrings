    },
    "This save has an unconfirmed outcome. Check the Apple app before trying again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le résultat de cet enregistrement n’est pas confirmé. Vérifiez l’app Apple avant de réessayer."
          }
        }
      }
    },
    "This saved routine uses a newer format. Your file has been kept intact.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette routine enregistrée utilise un format plus récent. Votre fichier a été conservé intact."
          }
        }
      }
    },
    "This saved source changed. Choose the excerpt again before adding it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette source enregistrée a changé. Choisissez à nouveau l’extrait avant de l’ajouter."
          }
        }
      }
    },
    "This setting couldn't be saved. %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce réglage n’a pas pu être enregistré. %@"
