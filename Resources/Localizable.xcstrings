        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’App Store est indisponible pour le moment. Vous pouvez continuer gratuitement ou réessayer plus tard."
          }
        }
      }
    },
    "MORE finds your first app use after a long break and uses recorded sleep when Health is connected.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MORE finds your first app use after a long break and uses recorded sleep when Health is connected."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MORE repère vos premiers usages après une longue pause et utilise votre sommeil enregistré lorsque Santé est connecté."
          }
        }
      }
    },
    "Morning: %@ – %@": {
      "localizations": {
        "en": {
          "stringUnit": {
