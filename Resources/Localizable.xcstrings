      }
    },
    "Learn again": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apprendre à nouveau"
          }
        }
      }
    },
    "Learn from Screen Time": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apprendre avec Temps d’écran"
          }
        }
      }
    },
    "Long scroll: you could keep this one shorter": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Long défilement : vous pourriez l’écourter"
          }
        }
      }
    },
    "MORE looks at the minutes you spent in each app over the last week and finds your mornings. Only app names and minutes are kept, on this iPhone. No messages, no screens, no websites.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MORE regarde les minutes passées dans chaque app la semaine dernière et retrouve vos matins. Seuls les noms d’apps et les minutes sont gardés, sur cet iPhone. Aucun message, aucun écran, aucun site web."
          }
        }
      }
    },
    "Measured or estimated?": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesuré ou estimé ?"
          }
        }
      }
    },
    "Measured: Screen Time counted these minutes inside your morning. Estimated: an hour ran past the end of your morning, so its minutes were shared out.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesuré : Temps d’écran a compté ces minutes pendant votre matin. Estimé : une heure dépassait la fin de votre matin, ses minutes ont donc été réparties."
          }
        }
      }
    },
    "Minutes estimated": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Minutes estimées"
          }
        }
      }
    },
    "Minutes measured": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Minutes mesurées"
          }
        }
      }
    },
    "Reading your last mornings…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lecture de vos derniers matins…"
          }
        }
      }
    },
    "Review suggestion": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voir la suggestion"
          }
        }
      }
    },
    "Review the apps, then approve when ready.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez les apps, puis approuvez quand vous êtes prêt."
          }
        }
      }
    },
    "Screen Time access wasn't given. You can allow it in Settings → Screen Time, then try again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès à Temps d’écran n’a pas été donné. Vous pouvez l’autoriser dans Réglages → Temps d’écran, puis réessayer."
          }
        }
      }
    },
    "Screen Time didn't answer this time. Try again in a moment.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temps d’écran n’a pas répondu cette fois. Réessayez dans un instant."
          }
        }
      }
    },
    "Screen Time had %lld days, but no complete morning with app use was found yet. Try again tomorrow.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temps d’écran avait %lld jours, mais aucun matin complet avec des apps n’a encore été trouvé. Réessayez demain."
          }
        }
      }
    },
    "Screen Time has no app minutes on this iPhone yet. Try again tomorrow morning.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temps d’écran n’a encore aucune minute d’app sur cet iPhone. Réessayez demain matin."
          }
        }
      }
    },
    "Suggestion ready: %lld apps from %lld mornings.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggestion prête : %1$lld apps tirées de %2$lld matins."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Suggestion ready: %1$lld apps from %2$lld mornings."
          }
        }
      }
    },
    "The suggestion couldn't be saved. Your routine is unchanged.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La suggestion n’a pas pu être enregistrée. Votre routine n’a pas changé."
          }
        }
      }
    },
    "Usually %lld min, on %lld of %lld mornings": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En général %1$lld min, %2$lld matins sur %3$lld"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Usually %1$lld min, on %2$lld of %3$lld mornings"
          }
        }
      }
    },
    "Your morning, from Screen Time": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre matin, d’après Temps d’écran"
          }
        }
      }
    },
    "Your mornings usually start around %@.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos matins commencent en général vers %@."
          }
        }
      }
    },
    "Your routine changed since this suggestion was made. Learn from Screen Time again for a fresh one.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre routine a changé depuis cette suggestion. Apprenez à nouveau avec Temps d’écran pour en avoir une à jour."
          }
        }
      }
    },
    "Your routine may have changed. Learn from Screen Time again for a fresh suggestion.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre routine a peut-être changé. Apprenez à nouveau avec Temps d’écran pour une suggestion à jour."
          }
        }
      }
    },
    "Screen Time gives minutes per hour, not the order inside an hour. So the order is estimated: the app you open most often from the Lock Screen comes first, then the others by hour, then by minutes.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temps d’écran donne des minutes par heure, pas l’ordre dans l’heure. L’ordre est donc estimé : l’app que vous ouvrez le plus souvent depuis l’écran verrouillé vient d’abord, puis les autres par heure, puis par minutes."
          }
        }
      }
    },
    "Your current routine stays ready until you approve. Approving replaces it with the apps you keep here.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre routine actuelle reste prête jusqu’à votre accord. Approuver la remplace par les apps gardées ici."
          }
        }
      }
    },
    "Learning from Screen Time needs iOS 26.4 or later.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apprendre avec Temps d’écran demande iOS 26.4 ou plus récent."
          }
        }
      }
    },
    "Start with your app use": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez par votre usage des apps"
          }
        }
      }
    },
    "Connect Screen Time, then show MORE a moment of your morning.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez Temps d’écran, puis montrez un moment de votre matinée à MORE."
          }
        }
      }
    },
    "Earlier days": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jours précédents"
          }
        }
      }
    },
    "Refresh app use": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualiser l’usage des apps"
          }
        }
      }
    },
    "Connect Screen Time": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecter Temps d’écran"
          }
        }
      }
    },
    "What Screen Time can show": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que montre Temps d’écran"
          }
        }
      }
    },
    "App minutes and pickup counts. It does not show taps, messages or scrolling speed.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La durée dans les apps et les prises en main. Ni les appuis, ni les messages, ni la vitesse de défilement."
          }
        }
      }
    },
    "Access depends on your iPhone and Apple Account region. Only one app can hold this access at a time.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès dépend de votre iPhone et de la région de votre compte Apple. Une seule app peut avoir cet accès à la fois."
          }
        }
      }
    },
    "Returned app use. Missing days stay unknown.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Usage renvoyé par Temps d’écran. Les jours absents restent inconnus."
          }
        }
      }
    },
    "From %lld comparable mornings. Order is estimated.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D’après %lld matins comparables. L’ordre est estimé."
          }
        }
      }
    },
    "Measured minutes come from complete hourly segments inside the detected morning. Other minutes are estimated from a partial hour.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les minutes mesurées viennent d’heures entières dans la matinée détectée. Les autres sont estimées à partir d’une heure partielle."
          }
        }
      }
    },
    "Long app use does not prove scrolling. Choose the budget you want.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une longue utilisation ne prouve pas un défilement. Choisissez la durée qui vous convient."
          }
        }
      }
    },
    "Opens %@": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre %@"
          }
        }
      }
    },
    "Choose an app or page in your routine.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une app ou une page dans votre routine."
          }
        }
      }
    },
    "Screen Time is connected.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temps d’écran est connecté."
          }
        }
      }
    },
    "Screen Time was approved without app-use data. Check this build’s capabilities and your device’s eligibility.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temps d’écran a été autorisé sans accès aux données d’usage. Vérifiez les capacités de cette version et l’éligibilité de votre appareil."
          }
        }
      }
    },
    "Connect Screen Time to read the app-use data available on this iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez Temps d’écran pour lire les données d’usage disponibles sur cet iPhone."
          }
        }
      }
    },
    "Screen Time returned app use, but no complete morning could be identified yet.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temps d’écran a renvoyé des données d’usage, mais aucune matinée complète n’a encore pu être identifiée."
          }
        }
      }
    },
    "Less than 1 min": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moins d’une minute"
          }
        }
      }
    },
    "Your websites": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos sites"
          }
        }
      }
    },
    "One guided sign-in pass": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une seule préparation pour vos connexions"
          }
        }
      }
    },
    "1 · See your rhythm": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 · Découvrez votre rythme"
          }
        }
      }
    },
    "Start with your real Screen Time": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez avec votre vrai Temps d’écran"
          }
        }
      }
    },
    "2 · Show your morning": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "2 · Montrez votre matin"
          }
        }
      }
    },
    "3 · Make yourself at home": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "3 · Installez-vous"
          }
        }
      }
    },
    "Sign in to your websites, together": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez vos sites en une seule fois"
          }
        }
      }
    },
    "Screen Time": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temps d’écran"
          }
        }
      }
    },
    "MORE guides native app steps. Inside MORE’s browser, you can ask it to read supported pages or move to the next video.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MORE vous guide dans les apps. Dans son navigateur, vous pouvez lui demander de lire les pages prises en charge ou de passer à la vidéo suivante."
          }
        }
      }
    },
    "A little setup. Then you're home.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un instant de préparation. Puis à vous de jouer."
          }
        }
      }
    },
    "Connect my websites": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecter mes sites"
          }
        }
      }
    },
    "Learning your scroll and tap rhythm": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apprentissage du rythme de vos gestes"
          }
        }
      }
    },
    "Only this page. This estimate does not replay your gestures.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette page seulement. Cette estimation ne reproduit pas vos gestes."
          }
        }
      }
    },
    "Stop learning": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêter l’apprentissage"
          }
        }
      }
    },
    "Save to Learn": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garder pour apprendre"
          }
        }
      }
    },
    "Sign in once, here. Your morning uses these same pages.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous ici une fois. Votre matin utilisera ces mêmes pages."
          }
        }
      }
    },
    "Screen Time is still stopping. Try removal again in a moment.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temps d’écran s’arrête encore. Réessayez la suppression dans un instant."
          }
        }
      }
    },
    "The timer couldn't be stopped safely. Try again before leaving this moment.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le minuteur n’a pas pu être arrêté en sécurité. Réessayez avant de quitter ce moment."
          }
        }
      }
    }
  },
  "version": "1.0"
}
