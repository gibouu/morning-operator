            "value": "Their original text, corrections, sampled screens and screen labels leave MORE on this device. Nothing else is removed unless it is listed below as removed."
          }
        }
      }
    },
    "There is no current briefing to read.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no current briefing to read."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun bilan à jour n’est disponible pour le moment."
          }
        }
      }
    },
    "There is no current step timer.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun minuteur d’étape en cours."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no current step timer."
          }
        }
      }
    },
    "There is nothing left to remove here. Nothing was removed.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n’y a plus rien à supprimer ici. Rien n’a été supprimé."
