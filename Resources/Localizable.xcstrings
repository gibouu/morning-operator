          }
        }
      }
    },
    "A dream. An idea. Something for later. Give it a place to land.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rêve. Une idée. Quelque chose pour plus tard. Donnez-lui une place."
          }
        }
      }
    },
    "A few words": {
      "localizations": {
        "fr": {
          "stringUnit": {
