{
  "sourceLanguage": "en",
  "strings": {
    "NSAlarmKitUsageDescription": {
      "comment": "Privacy usage description",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MORE schedules your morning alarm and opens your approved morning when you stop it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MORE programme votre réveil et ouvre votre matinée approuvée quand vous l’arrêtez."
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "comment": "Privacy usage description",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MORE reads your schedule for spoken briefings and saves calendar events only when you confirm them."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MORE lit votre agenda pour les récaps lus à voix haute et n’enregistre des événements que lorsque vous les confirmez."
          }
        }
      }
    },
    "NSCalendarsWriteOnlyAccessUsageDescription": {
      "comment": "Privacy usage description",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MORE adds the calendar event you review and choose to save."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MORE ajoute l’événement que vous avez relu et choisi d’enregistrer."
          }
        }
      }
    },
    "NSContactsUsageDescription": {
      "comment": "Privacy usage description",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MORE reads contact birthdays to mention one in your morning. Names are spoken and never saved."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MORE lit les anniversaires de vos contacts pour en mentionner un le matin. Les noms sont dits et jamais enregistrés."
          }
        }
      }
    },
    "NSHealthShareUsageDescription": {
      "comment": "SDK-free beta: local microphone listening; selected read-aloud passages may use the optional HTTPS voice service.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MORE reads only the sleep, optional steps, resting heart rate, heart rate variability (SDNN) and breathing rate you explicitly choose for your morning. Readings stay on this iPhone unless you choose online reading aloud. MORE never writes Health data."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MORE lit uniquement le sommeil, les pas facultatifs, la fréquence cardiaque au repos, la variabilité de la fréquence cardiaque (SDNN) et la fréquence respiratoire que vous choisissez explicitement pour votre matin. Les données restent sur cet iPhone sauf si vous choisissez la lecture à voix haute en ligne. MORE n’écrit jamais de données Santé."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "comment": "Required HealthKit submission metadata; authorization remains read-only and MORE never writes Health data.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MORE uses HealthKit to read the sleep and health information you choose for your morning briefing. MORE does not add or change Health data."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MORE utilise HealthKit pour lire les données de sommeil et de santé que vous choisissez pour votre briefing du matin. MORE n’ajoute ni ne modifie aucune donnée Santé."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "comment": "SDK-free beta: local microphone listening; selected read-aloud passages may use the optional HTTPS voice service.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MORE listens on this iPhone so you can interrupt or ask a question during your morning. Listening stops when you end the morning or leave the app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MORE vous écoute sur cet iPhone pour interrompre ou poser une question pendant votre matin. L’écoute s’arrête à la fin du matin ou quand vous quittez l’app."
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription": {
      "comment": "Privacy usage description",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MORE saves the reminders you confirm and can read reminders for your morning briefing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MORE enregistre les rappels que vous confirmez et peut lire vos rappels pour le récap du matin."
          }
        }
      }
    },
    "NSScreenCaptureUsageDescription": {
      "comment": "Privacy usage description",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you start a recording, MORE captures the screen content you explicitly share to help understand your morning routine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous lancez un enregistrement, MORE capture le contenu de l’écran que vous partagez explicitement pour mieux comprendre votre routine du matin."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "comment": "Privacy usage description",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MORE transcribes your words on this iPhone to show live captions and understand your voice commands and drafts."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MORE transcrit vos paroles sur cet iPhone pour les afficher en direct et comprendre vos commandes et vos notes dictées."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "comment": "Foreground location for weather and local solar position. Approximate location is sufficient.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MORE uses your current location while open for local weather and a sky that follows the sun. An approximate location is enough."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand MORE est ouvert, votre position apporte la météo locale et un ciel qui suit le soleil. Une position approximative suffit."
          }
        }
      }
    }
  },
  "version": "1.0"
}
