    "%lld%% of senders are not in the contacts shared with this app.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld %% des expéditeurs ne figurent pas dans les contacts partagés avec cette app."
          }
        }
      }
    },
    "A proposed step could not be tied to the exact supplied evidence. Your current routine is unchanged.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une étape proposée n’a pas pu être reliée aux éléments exacts fournis. Votre routine actuelle n’a pas changé."
          }
        }
      }
    },
    "A reminder alert needs a due date and time.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une alerte de rappel nécessite une date et une heure d’échéance."
          }
        }
      }
    },
    "A selected calendar is no longer available. Review your calendar selection before refreshing.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un calendrier sélectionné n’est plus disponible. Vérifiez votre sélection avant d’actualiser."
          }
        }
      }
    },
    "A visible-context analysis is already running.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une analyse du contexte visible est déjà en cours."
          }
        }
      }
    },
    "Actual presentation time was unavailable; the requested sample time is retained as a fallback.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’heure réelle d’affichage était indisponible ; l’heure d’échantillon demandée est conservée par défaut."
          }
        }
      }
    },
    "Add observations or import a readable screen recording before analyzing.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des observations ou importez un enregistrement d’écran lisible avant l’analyse."
          }
        }
      }
    },
    "Allow notifications to schedule this invitation.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez les notifications pour programmer cette invitation."
          }
        }
      }
    },
    "An analysis is already running. Wait for it to finish or cancel it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une analyse est déjà en cours. Attendez qu’elle se termine ou annulez-la."
          }
        }
      }
    },
    "An observation contains invalid or inconsistent source evidence.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une observation contient des éléments sources invalides ou incohérents."
          }
        }
      }
    },
    "An unexpected item remains in the recording folder. It hasn't been removed.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un élément inattendu reste dans le dossier d’enregistrement. Il n’a pas été supprimé."
          }
        }
      }
    },
    "An unsupported saved interpretation was removed. The original observation is still available.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une interprétation enregistrée non étayée a été supprimée. L’observation d’origine est toujours disponible."
          }
        }
      }
    },
    "App-owned recordings removed.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrements de l’app supprimés."
          }
        }
      }
    },
    "Apple Foundation Models is available for local visible-context analysis.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Foundation Models est disponible pour l’analyse locale du contexte visible."
          }
        }
      }
    },
    "Apple Foundation Models is available. Analysis runs locally on this device.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Foundation Models est disponible. L’analyse s’exécute localement sur cet appareil."
          }
        }
      }
    },
    "Apple Intelligence is not enabled on this device.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence n’est pas activé sur cet appareil."
          }
        }
      }
    },
    "Apple Maps couldn't search for cities right now. Try again later.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plans d’Apple n’a pas pu rechercher de villes pour le moment. Réessayez plus tard."
          }
        }
      }
    },
    "Apple Weather denied access. This build's WeatherKit capability and developer setup need checking.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Météo Apple a refusé l’accès. La capacité WeatherKit de cette version et la configuration développeur doivent être vérifiées."
          }
        }
      }
    },
    "Apple Weather is unavailable right now. Your morning can continue without it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Météo Apple est indisponible pour le moment. Votre matinée peut continuer sans elle."
          }
        }
      }
    },
    "Apple Weather returned incomplete current conditions. Try refreshing the weather.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Météo Apple a renvoyé des conditions actuelles incomplètes. Essayez d’actualiser la météo."
          }
        }
      }
    },
    "Apple Weather's required source information couldn't be loaded. Try refreshing the weather.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les informations de source requises par Météo Apple n’ont pas pu être chargées. Essayez d’actualiser la météo."
          }
        }
      }
    },
    "Apple's local model is currently unavailable.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle local d’Apple est actuellement indisponible."
          }
        }
      }
    },
    "Apple's local model is not ready.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle local d’Apple n’est pas prêt."
          }
        }
      }
    },
    "Apple's local model is not ready. It may still be downloading.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle local d’Apple n’est pas prêt. Il est peut-être encore en cours de téléchargement."
          }
        }
      }
    },
    "Apple's local model is unavailable.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle local d’Apple est indisponible."
          }
        }
      }
    },
    "Apple's local model is unavailable. %@ You can still write and edit your routine manually.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle local d’Apple est indisponible. %@ Vous pouvez toujours écrire et modifier votre routine vous-même."
          }
        }
      }
    },
    "Assign an observed day to every selected observation first.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attribuez d’abord un jour observé à chaque observation sélectionnée."
          }
        }
      }
    },
    "Audio output changed. Play the voice again when ready.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sortie audio a changé. Relancez la voix quand vous le souhaitez."
          }
        }
      }
    },
    "Audio output changed. Resume when you are ready to listen.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sortie audio a changé. Reprenez quand vous voulez écouter."
          }
        }
      }
    },
    "Audio output is unavailable: %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sortie audio est indisponible : %@"
          }
        }
      }
    },
    "Automatic progression is stopped. Your current step is preserved.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La progression automatique est arrêtée. Votre étape actuelle est conservée."
          }
        }
      }
    },
    "Briefing data is unavailable. Check your sources and local privacy settings.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données du récap sont indisponibles. Vérifiez vos sources et vos réglages de confidentialité."
          }
        }
      }
    },
    "Calculated from capture time using %lld elapsed minutes. Review the date and time before saving.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculé à partir de l’heure de la note, avec %lld minutes écoulées. Vérifiez la date et l’heure avant d’enregistrer."
          }
        }
      }
    },
    "Calendar reading is not authorized. You can continue without a calendar snapshot.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La lecture du calendrier n’est pas autorisée. Vous pouvez continuer sans calendrier."
          }
        }
      }
    },
    "Calendar source": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Source du calendrier"
          }
        }
      }
    },
    "Calendar writing is not authorized. Connect Calendar before saving.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’écriture dans le calendrier n’est pas autorisée. Connectez Calendrier avant d’enregistrer."
          }
        }
      }
    },
    "Checking Apple's local model…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérification du modèle local d’Apple…"
          }
        }
      }
    },
    "Checking microphone and speech access…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérification de l’accès au micro et à la reconnaissance vocale…"
          }
        }
      }
    },
    "Choose a local file using the import picker.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un fichier local avec le sélecteur d’import."
          }
        }
      }
    },
    "Choose a local regular file to identify.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un fichier local standard à identifier."
          }
        }
      }
    },
    "Choose a recording shorter than %lld minutes for this prototype.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un enregistrement de moins de %lld minutes pour ce prototype."
          }
        }
      }
    },
    "Choose a reminder date range of at most 90 days and a result limit from 1 to 200.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une période de rappels de 90 jours au maximum et une limite de 1 à 200 résultats."
          }
        }
      }
    },
    "Choose a saved routine file.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un fichier de routine enregistré."
          }
        }
      }
    },
    "Choose a screenshot, a video, or a UTF-8 text/Markdown file.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une capture d’écran, une vidéo ou un fichier texte/Markdown UTF-8."
          }
        }
      }
    },
    "Choose a valid city for the weather.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une ville valide pour la météo."
          }
        }
      }
    },
    "Choose a valid observed date and time zone.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une date observée et un fuseau horaire valides."
          }
        }
      }
    },
    "Choose a valid time zone for this briefing.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un fuseau horaire valide pour ce récap."
          }
        }
      }
    },
    "Choose a valid time zone.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un fuseau horaire valide."
          }
        }
      }
    },
    "Choose at least one calendar before preparing a calendar briefing.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez au moins un calendrier avant de préparer un récap d’agenda."
          }
        }
      }
    },
    "Choose the observed day before adding this saved text to your morning.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez le jour observé avant d’ajouter ce texte enregistré à votre matinée."
          }
        }
      }
    },
    "Choose valid calendars and a city for the briefing.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez des calendriers et une ville valides pour le récap."
          }
        }
      }
    },
    "Choose valid dates with an event end after its start, lasting at most 31 days.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez des dates valides, avec une fin d’événement après le début et une durée de 31 jours au maximum."
          }
        }
      }
    },
    "Choose what to share using Apple's screen-recording picker.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez ce que vous partagez avec le sélecteur d’enregistrement d’écran d’Apple."
          }
        }
      }
    },
    "Choose your own observation or a separate synthetic sample.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez votre propre observation ou un exemple synthétique séparé."
          }
        }
      }
    },
    "Confirm screen sharing in the system picker to begin.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmez le partage d’écran dans le sélecteur du système pour commencer."
          }
        }
      }
    },
    "Conflicting or duplicate proposals were rejected.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les propositions contradictoires ou en double ont été rejetées."
          }
        }
      }
    },
    "Context remains unknown.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contexte reste inconnu."
          }
        }
      }
    },
