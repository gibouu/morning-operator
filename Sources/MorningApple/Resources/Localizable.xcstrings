    },
    " Messages mentioning urgency or a deadline come first; you can choose another message.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Les mentions d’urgence ou d’échéance passent en premier ; vous pouvez choisir un autre message."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Messages mentioning urgency or a deadline come first; you can choose another message."
          }
        }
      }
    },
    " Other unread emails have not been reviewed.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " D’autres mails non lus n’ont pas été consultés."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Other unread emails have not been reviewed."
          }
        }
      }
    },
    " They follow your inbox order.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Ils suivent l’ordre de votre boîte de réception."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " They follow your inbox order."
          }
        }
      }
    },
    " Would you like to reply to the first one? You can also choose a number, prepare a note to yourself, or continue your morning.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Voulez-vous répondre au premier ? Vous pouvez aussi choisir un numéro, préparer une note à vous-même ou continuer votre matin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Would you like to reply to the first one? You can also choose a number, prepare a note to yourself, or continue your morning."
          }
        }
      }
    },
    "%@ finished.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ terminé."
          }
        },
