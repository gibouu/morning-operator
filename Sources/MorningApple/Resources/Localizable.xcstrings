    },
    "The saved recording cannot be opened. It has not been overwritten.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement sauvegardé ne peut pas être ouvert. Il n’a pas été écrasé."
