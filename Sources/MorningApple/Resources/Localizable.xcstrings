          "stringUnit": {
            "state": "translated",
            "value": "These observations exceed the saved-source limit of %lld characters. Longer saved observations within that limit are analyzed in smaller requests."
          }
        }
      }
    },
    "These saved observations exceed the bounded local workload or contain a text unit too large to send safely. Your complete saved source is unchanged; nothing was silently shortened.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
