    "%lld of %lld requested frames could not be analyzed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld of %#@n@ could not be analyzed."
          },
          "substitutions": {
            "n": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg requested frame"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg requested frames"
                    }
                  }
                }
              }
            }
          }
