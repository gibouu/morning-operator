          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shared rule: use of at least 30 seconds, presence in at least half the retained comparable windows, median rounded to a minute and planned duration between 1 and 240 minutes. Order stays estimated and missing use unknown. All aggregates remain in the sources."
