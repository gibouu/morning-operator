    "A proposed step could not be tied to the exact supplied evidence. Your current routine is unchanged.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une étape proposée n’a pas pu être reliée aux éléments exacts fournis. Votre routine actuelle n’a pas changé."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A proposed step could not be tied to the exact supplied evidence. Your current routine is unchanged."
          }
        }
      }
    },
    "A reminder alert needs a due date and time.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une alerte de rappel nécessite une date et une heure d’échéance."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A reminder alert needs a due date and time."
          }
        }
      }
    },
    "A reply could not be prepared. You can write your reply below.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de préparer une réponse. Vous pouvez écrire votre réponse ci-dessous."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A reply could not be prepared. You can write your reply below."
          }
        }
      }
    },
    "A reply is already being prepared.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une réponse est déjà en préparation."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A reply is already being prepared."
          }
        }
      }
    },
    "A selected calendar is no longer available. Review your calendar selection before refreshing.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un calendrier sélectionné n’est plus disponible. Vérifiez votre sélection avant d’actualiser."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A selected calendar is no longer available. Review your calendar selection before refreshing."
          }
        }
      }
    },
    "A selected recording has no usable activity evidence. Some of its samples were left out because MORE itself was in front when they were taken. Use your other apps while a recording runs, or choose another observation.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un enregistrement sélectionné ne contient aucun élément d’activité exploitable. Certains de ses échantillons ont été écartés parce que MORE était au premier plan au moment de leur capture. Utilisez vos autres apps pendant l’enregistrement, ou choisissez une autre observation."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A selected recording has no usable activity evidence. Some of its samples were left out because MORE itself was in front when they were taken. Use your other apps while a recording runs, or choose another observation."
          }
        }
      }
    },
    "A visible-context analysis is already running.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une analyse du contexte visible est déjà en cours."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A visible-context analysis is already running."
          }
        }
      }
    },
    "Actual presentation time was unavailable; the requested sample time is retained as a fallback.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’heure réelle d’affichage était indisponible ; l’heure d’échantillon demandée est conservée par défaut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Actual presentation time was unavailable; the requested sample time is retained as a fallback."
          }
        }
      }
    },
    "Add observations or import a readable screen recording before analyzing.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des observations ou importez un enregistrement d’écran lisible avant l’analyse."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add observations or import a readable screen recording before analyzing."
          }
        }
      }
    },
    "All right, I’ll continue your morning.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D’accord, je continue votre matin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All right, I’ll continue your morning."
          }
        }
      }
    },
    "Allow notifications to schedule this invitation.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez les notifications pour programmer cette invitation."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow notifications to schedule this invitation."
          }
        }
      }
    },
    "An analysis is already running. Wait for it to finish or cancel it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une analyse est déjà en cours. Attendez qu’elle se termine ou annulez-la."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An analysis is already running. Wait for it to finish or cancel it."
          }
        }
      }
    },
    "An observation contains invalid or inconsistent source evidence.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une observation contient des éléments sources invalides ou incohérents."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An observation contains invalid or inconsistent source evidence."
          }
        }
      }
    },
    "An unexpected item remains in the recording folder. It hasn't been removed.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un élément inattendu reste dans le dossier d’enregistrement. Il n’a pas été supprimé."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An unexpected item remains in the recording folder. It hasn't been removed."
          }
        }
      }
    },
    "An unsupported saved interpretation was removed. The original observation is still available.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une interprétation enregistrée non étayée a été supprimée. L’observation d’origine est toujours disponible."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An unsupported saved interpretation was removed. The original observation is still available."
          }
        }
      }
    },
    "Another reply to this email was already attempted this morning. This new draft has not been sent. Check sent mail before preparing another reply. Say no to continue.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une autre réponse a déjà été tentée pour ce mail pendant ce matin. Ce nouveau brouillon n’a pas été envoyé. Vérifiez les messages envoyés avant de préparer une nouvelle réponse. Dites non pour continuer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another reply to this email was already attempted this morning. This new draft has not been sent. Check sent mail before preparing another reply. Say no to continue."
          }
        }
      }
    },
    "App-owned recordings removed.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrements de l’app supprimés."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App-owned recordings removed."
          }
        }
      }
    },
