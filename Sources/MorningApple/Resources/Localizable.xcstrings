        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source took too long to respond. Your morning can continue without it."
          }
        }
      }
    },
    "The system interrupted this recording. It may cover only part of your morning.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le système a interrompu cet enregistrement. Il ne couvre peut-être qu’une partie de votre matinée."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system interrupted this recording. It may cover only part of your morning."
          }
        }
      }
    },
    "The system is still finishing the previous image. Another image cannot be read yet. Your saved observations are unchanged; you can describe the routine instead.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system is still finishing the previous image. Another image cannot be read yet. Your saved observations are unchanged; you can describe the routine instead."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le système termine encore l’image précédente. Une autre image ne peut pas encore être lue. Vos observations enregistrées sont conservées ; vous pouvez décrire votre routine à la place."
          }
        }
      }
    },
    "The system recording request took too long. It is being cancelled; no file will be imported.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La demande d’enregistrement du système a pris trop de temps. Elle est annulée ; aucun fichier ne sera importé."
