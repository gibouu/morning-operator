    "Apple Maps couldn't search for cities right now. Try again later.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plans d’Apple n’a pas pu rechercher de villes pour le moment. Réessayez plus tard."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Maps couldn't search for cities right now. Try again later."
          }
        }
      }
    },
    "Apple Weather denied access. This build's WeatherKit capability and developer setup need checking.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Météo Apple a refusé l’accès. La capacité WeatherKit de cette version et la configuration développeur doivent être vérifiées."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Weather denied access. This build's WeatherKit capability and developer setup need checking."
          }
        }
      }
    },
    "Apple Weather is unavailable right now. Your morning can continue without it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Météo Apple est indisponible pour le moment. Votre matinée peut continuer sans elle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Weather is unavailable right now. Your morning can continue without it."
          }
        }
      }
    },
    "Apple Weather returned incomplete current conditions. Try refreshing the weather.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Météo Apple a renvoyé des conditions actuelles incomplètes. Essayez d’actualiser la météo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Weather returned incomplete current conditions. Try refreshing the weather."
          }
        }
      }
    },
    "Apple Weather's required source information couldn't be loaded. Try refreshing the weather.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les informations de source requises par Météo Apple n’ont pas pu être chargées. Essayez d’actualiser la météo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Weather's required source information couldn't be loaded. Try refreshing the weather."
