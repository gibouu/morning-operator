    },
    "The send is uncertain. Say check to look for this reply in sent mail, or no to continue. I will not send it again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’envoi est incertain. Dites vérifier pour rechercher cette réponse dans les messages envoyés, ou non pour continuer. Je ne la renvoie pas."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The send is uncertain. Say check to look for this reply in sent mail, or no to continue. I will not send it again."
          }
        }
      }
    },
    "The send is unconfirmed. I will not send this message again. Say check to review sent mail, or no to continue.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’envoi n’est pas confirmé. Je ne renvoie pas ce message. Dites vérifier pour consulter les messages envoyés, ou non pour continuer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The send is unconfirmed. I will not send this message again. Say check to review sent mail, or no to continue."
          }
        }
      }
    },
    "The shortcut didn't return in time. Check it in Shortcuts before running it again.": {
      "localizations": {
