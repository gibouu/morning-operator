    },
    "The saved recording's metadata cannot be read. The recording and metadata have been kept unchanged.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les métadonnées de l’enregistrement ne peuvent pas être lues. L’enregistrement et ses métadonnées ont été conservés tels quels."
