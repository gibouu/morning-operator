<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>MorningURLScheme</key>
	<string>more</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>fr</string>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>MORE</string>
	<key>CFBundleDisplayName</key>
	<string>MORE</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.gibouu.morningoperator.morning</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>more</string>
			</array>
		</dict>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>sms</string>
		<string>message</string>
		<string>whatsapp</string>
		<string>instagram</string>
		<string>calshow</string>
		<string>maps</string>
	</array>
	<key>NSAlarmKitUsageDescription</key>
	<string>MORE schedules your morning alarm and opens your approved morning when you stop it.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>MORE listens during the voice turns you start on this device.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>MORE transcribes your requested voice commands and drafts.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>MORE reads your schedule for spoken briefings and saves calendar events only when you confirm them.</string>
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
	<string>MORE adds the calendar event you review and choose to save.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>MORE saves the reminders you confirm and can read reminders for your morning briefing.</string>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>screen-capture</string>
	</array>
	<key>NSScreenCaptureUsageDescription</key>
	<string>When you start a recording, MORE captures the screen content you explicitly share to help understand your morning routine.</string>
</dict>
</plist>
