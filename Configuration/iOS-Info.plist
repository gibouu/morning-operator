<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>UIAppFonts</key>
	<array>
		<string>DMSerifDisplay.ttf</string>
		<string>Raleway.ttf</string>
	</array>
	<key>MorningURLScheme</key>
	<string>more</string>
	<key>MOREGoogleClientID</key>
	<string>$(MORE_GOOGLE_CLIENT_ID)</string>
	<key>MorningAPIBaseURL</key>
	<string>$(MORNING_API_BASE_URL)</string>
	<key>MORESubscriptionProductID</key>
	<string>$(MORE_SUBSCRIPTION_PRODUCT_ID)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>fr</string>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>MORE</string>
	<key>CFBundleDisplayName</key>
	<string>MORE</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.gibouu.morningoperator.morning</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>more</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.gibouu.morningoperator.google</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(MORE_GOOGLE_CALLBACK_SCHEME)</string>
			</array>
		</dict>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>sms</string>
		<string>message</string>
		<string>whatsapp</string>
		<string>instagram</string>
		<string>calshow</string>
		<string>maps</string>
	</array>
	<key>NSAlarmKitUsageDescription</key>
	<string>MORE schedules your morning alarm and opens your approved morning when you stop it.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>MORE uses your current location while open for local weather and a sky that follows the sun. An approximate location is enough.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>MORE reads only the sleep, optional steps, resting heart rate, heart rate variability (SDNN) and breathing rate you explicitly choose for your morning. Readings stay on this iPhone unless you choose online reading aloud. MORE never writes Health data.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>MORE uses HealthKit to read the sleep and health information you choose for your morning briefing. MORE does not add or change Health data.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>MORE listens on this iPhone so you can interrupt or ask a question during your morning. Listening stops when you end the morning or leave the app.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>MORE transcribes your words on this iPhone to show live captions and understand your voice commands and drafts.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>MORE reads your schedule for spoken briefings and saves calendar events only when you confirm them.</string>
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
	<string>MORE adds the calendar event you review and choose to save.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>MORE saves the reminders you confirm and can read reminders for your morning briefing.</string>

	<key>NSContactsUsageDescription</key>
	<string>MORE reads contact birthdays to mention one in your morning. Names are spoken and never saved.</string>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>screen-capture</string>
	</array>
	<key>NSScreenCaptureUsageDescription</key>
	<string>When you start a recording, MORE captures the screen content you explicitly share to help understand your morning routine.</string>
</dict>
</plist>
