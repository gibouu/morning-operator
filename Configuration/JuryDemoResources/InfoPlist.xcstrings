{
  "sourceLanguage": "en",
  "strings": {
    "NSAlarmKitUsageDescription": {
      "comment": "Privacy usage description",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MORE schedules your morning alarm and opens your approved morning when you stop it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MORE programme votre réveil et ouvre votre matinée approuvée quand vous l’arrêtez."
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "comment": "Privacy usage description",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MORE reads your schedule for spoken briefings and saves calendar events only when you confirm them."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MORE lit votre agenda pour les récaps lus à voix haute et n’enregistre des événements que lorsque vous les confirmez."
          }
        }
      }
    },
    "NSCalendarsWriteOnlyAccessUsageDescription": {
      "comment": "Privacy usage description",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MORE adds the calendar event you review and choose to save."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MORE ajoute l’événement que vous avez relu et choisi d’enregistrer."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "comment": "Privacy usage description",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MORE listens during your hands-free morning so you can interrupt, pause or request an action, including while you use another app. Listening stops when you end your morning."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MORE écoute pendant votre matin mains libres pour vous permettre de l’interrompre, de mettre en pause ou de demander une action, y compris quand vous utilisez une autre app. L’écoute s’arrête quand vous terminez votre matin."
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription": {
      "comment": "Privacy usage description",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MORE saves the reminders you confirm and can read reminders for your morning briefing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MORE enregistre les rappels que vous confirmez et peut lire vos rappels pour le récap du matin."
          }
        }
      }
    },
    "NSScreenCaptureUsageDescription": {
      "comment": "Privacy usage description",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you start a recording, MORE captures the screen content you explicitly share to help understand your morning routine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous lancez un enregistrement, MORE capture le contenu de l’écran que vous partagez explicitement pour mieux comprendre votre routine du matin."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "comment": "Privacy usage description",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MORE transcribes your words on this iPhone to show live captions and understand your voice commands and drafts."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MORE transcrit vos paroles sur cet iPhone pour les afficher en direct et comprendre vos commandes et vos notes dictées."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "comment": "Foreground location for weather and local solar position. Approximate location is sufficient.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MORE uses your current location while open for local weather and a sky that follows the sun. An approximate location is enough."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand MORE est ouvert, votre position apporte la météo locale et un ciel qui suit le soleil. Une position approximative suffit."
          }
        }
      }
    },
    "NSHealthShareUsageDescription": {
      "comment": "Explicitly chosen read scope; local by default, optional online voice conversation disclosed separately.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MORE reads only the sleep, optional steps, resting heart rate, heart rate variability (SDNN) and breathing rate you explicitly choose for your morning. Readings stay on this iPhone unless you start the optional online conversation. MORE never writes Health data."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MORE lit uniquement le sommeil, les pas facultatifs, la fréquence cardiaque au repos, sa variabilité (SDNN) et la fréquence respiratoire que vous choisissez pour votre matin. Ces lectures restent sur cet iPhone sauf si vous démarrez la conversation en ligne facultative. MORE ne modifie aucune donnée Santé."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "comment": "Local jury backend only",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MORE connects to your local demonstration service for the interactive morning you choose to start."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MORE se connecte à votre service local de démonstration pour le matin interactif que vous choisissez de lancer."
          }
        }
      }
    }
  },
  "version": "1.0"
}
